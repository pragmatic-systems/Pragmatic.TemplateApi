<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UserSecretsId>906f752f-f3ab-4819-8b5c-43d9bd0ab85c</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..</DockerfileContext>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.21.0" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.17" />
    <PackageReference Include="Hangfire.PostgreSql" Version="1.9.2" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pragmatic.TemplateApi.Core\Pragmatic.TemplateApi.Core.csproj" />
    <ProjectReference Include="..\Pragmatic.TemplateApi.Database\Pragmatic.TemplateApi.Database.csproj" />
    <ProjectReference Include="..\Pragmatic.TemplateApi.Instrumentation\Pragmatic.TemplateApi.Instrumentation.csproj" />
  </ItemGroup>

  <!-- Install Husky.Net githooks on restore. Forces secret scan / format. -->
  <Target Name="RestoreDotnetTools" BeforeTargets="Restore;CollectPackageReferences" Condition="'$(HUSKY)' != '0'">
    <Exec Command="dotnet tool restore" WorkingDirectory="$(MSBuildThisFileDirectory)..\.." ContinueOnError="true" />
    <Exec Command="dotnet husky install" WorkingDirectory="$(MSBuildThisFileDirectory)..\.." ContinueOnError="true" />
  </Target>
  
</Project>
