{
  "DetailedErrors": true,
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Seq"
    ],
    "WriteTo": [
      {
        "Name": "Seq",
        "Args": {
          "restrictedToMinimumLevel": "Information",
          "compact": true,
          "serverUrl": "http://localhost:5030"
        }
      }
    ]
  },
  "RabbitMQ": {
    "ConnectionString": "amqp://local:local@localhost:5672",
    "QueueName": "todo-message",
    "PrefetchCount": 10
  },
  "AllowedHosts": "*"
}
